# ============================================
# Yumi WhatsApp — variaveis de ambiente
# Copie este arquivo para .env.local e preencha
# ============================================

# --- Supabase (projeto NOVO, so deste app) ---
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA expor no front. So usada nas rotas de API (server).
SUPABASE_SERVICE_ROLE_KEY=

# --- Z-API (WhatsApp) ---
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
# Segredo proprio: vai na URL do webhook (?secret=...) para validar origem
ZAPI_WEBHOOK_SECRET=

# --- Anthropic (cerebro da Yumi) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Quantas mensagens anteriores entram no contexto da Yumi
YUMI_CONTEXT_MESSAGES=20

# --- Links do restaurante ---
NEXT_PUBLIC_LINK_RESERVA=
NEXT_PUBLIC_LINK_FILA=

# --- App ---
# URL publica final (ex: https://chat.kaizenjapanese.com.br)
NEXT_PUBLIC_APP_URL=http://localhost:3000
