# ============================================
# Yumi WhatsApp — variaveis de ambiente
# Copie este arquivo para .env.local e preencha
# ============================================

# --- Supabase (projeto NOVO, so deste app) ---
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA expor no front. So usada nas rotas de API (server).
SUPABASE_SERVICE_ROLE_KEY=

# --- Z-API (WhatsApp) ---
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
# Segredo proprio: vai na URL do webhook (?secret=...) para validar origem
ZAPI_WEBHOOK_SECRET=

# --- OpenAI (cerebro da Yumi) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Quantas mensagens anteriores entram no contexto da Yumi
YUMI_CONTEXT_MESSAGES=20
# Opcional: modelo diferente so pra analise diaria (default: usa OPENAI_MODEL)
OPENAI_MODEL_ANALISE=

# --- Dashboard / motor de analise diaria ---
# Protege POST /api/cron/analise. Gere com: openssl rand -hex 16
CRON_SECRET=

# --- Links do restaurante ---
NEXT_PUBLIC_LINK_RESERVA=
NEXT_PUBLIC_LINK_FILA=

# --- App ---
# URL publica final (ex: https://chat.kaizenjapanese.com.br)
NEXT_PUBLIC_APP_URL=http://localhost:3000
